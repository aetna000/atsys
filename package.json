{
  "name": "atsys",
  "version": "0.3.0-beta.1",
  "private": true,
  "type": "module",
  "description": "Local-first agent supervision and control console",
  "engines": {
    "node": ">=22.16.0"
  },
  "bin": {
    "atsys": "bin/atsys.mjs"
  },
  "scripts": {
    "dev": "concurrently -k -n api,ui 'tsx watch server/index.ts' 'vite --host 127.0.0.1'",
    "dev:api": "tsx watch server/index.ts",
    "dev:ui": "vite --host 127.0.0.1",
    "start": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:e2e": "playwright test",
    "atsys": "node bin/atsys.mjs",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"shared/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,json,html}\" \"bin/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"shared/**/*.ts\" \"tests/**/*.ts\" \"*.{ts,json,html}\" \"bin/*.mjs\"",
    "build:python": "node scripts/build-python.mjs"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/dm-sans": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@mui/material": "^7.3.0",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.5",
    "recharts": "^3.3.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.2.2"
  }
}
