{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "goalContract": {
      "type": "object",
      "properties": {
        "version": {
          "type": "number",
          "const": 1
        },
        "successCriteria": {
          "minItems": 1,
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "deliverables": {
          "minItems": 1,
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "constraints": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "assumptions": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "unresolvedDecisions": {
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "stages": {
          "minItems": 1,
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "planSource": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "observers": {
          "minItems": 1,
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "signal": {
                "type": "string",
                "enum": [
                  "heartbeat",
                  "progress",
                  "activity",
                  "validator",
                  "hook"
                ]
              },
              "rationale": {
                "type": "string",
                "minLength": 1,
                "maxLength": 2000
              },
              "cadenceSeconds": {
                "type": "integer",
                "minimum": 1,
                "maximum": 86400
              },
              "hookId": {
                "type": "string",
                "maxLength": 120
              }
            },
            "required": [
              "signal",
              "rationale",
              "cadenceSeconds"
            ],
            "additionalProperties": false
          }
        },
        "recoveryScope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "escalationConditions": {
          "minItems": 1,
          "maxItems": 30,
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2000
          }
        },
        "budget": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "required": [
        "version",
        "successCriteria",
        "deliverables",
        "constraints",
        "assumptions",
        "unresolvedDecisions",
        "stages",
        "planSource",
        "observers",
        "recoveryScope",
        "escalationConditions",
        "budget"
      ],
      "additionalProperties": false
    },
    "outcomeFile": {
      "type": "string",
      "maxLength": 1000
    },
    "outcomeRequired": {
      "type": "boolean"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "objective": {
      "type": "string",
      "minLength": 3,
      "maxLength": 6000
    },
    "cwd": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "worker": {
      "type": "string",
      "enum": [
        "command",
        "codex"
      ]
    },
    "argv": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 8000
      }
    },
    "resumeArgv": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 8000
      }
    },
    "model": {
      "type": "string",
      "maxLength": 100
    },
    "reasoningEffort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "validator": {
      "type": "string",
      "enum": [
        "exit-code",
        "command",
        "benchmark-json"
      ]
    },
    "validationArgv": {
      "maxItems": 100,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 8000
      }
    },
    "validationTimeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 86400
    },
    "requiredArtifacts": {
      "maxItems": 30,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 1000
      }
    },
    "activityTimeoutSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400
    },
    "plan": {
      "type": "string",
      "maxLength": 12000
    },
    "artifact": {
      "type": "string",
      "maxLength": 1000
    },
    "progressFile": {
      "type": "string",
      "maxLength": 1000
    },
    "timeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 604800
    },
    "taskTimeoutSeconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 2592000
    },
    "heartbeatTimeoutSeconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 300
    },
    "progressTimeoutSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400
    },
    "recovery": {
      "type": "string",
      "enum": [
        "notify",
        "restart",
        "supervised"
      ]
    },
    "maxRetries": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "backoffSeconds": {
      "type": "integer",
      "minimum": 0,
      "maximum": 3600
    },
    "supervisorModel": {
      "type": "string",
      "maxLength": 100
    },
    "supervisorEffort": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    },
    "supervisorTimeoutSeconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 3600
    },
    "maxSupervisorCalls": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10
    },
    "allowRepair": {
      "type": "boolean"
    },
    "repairTimeoutSeconds": {
      "type": "integer",
      "minimum": 5,
      "maximum": 7200
    },
    "networkAccess": {
      "default": false,
      "type": "boolean"
    },
    "goalMonitoring": {
      "default": true,
      "type": "boolean"
    },
    "hooks": {
      "default": [],
      "maxItems": 16,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-zA-Z0-9_-]{1,64}$"
          },
          "events": {
            "minItems": 1,
            "maxItems": 17,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "before_run",
                "after_run",
                "on_run_error",
                "on_tick",
                "before_validation",
                "after_validation",
                "on_recovery",
                "on_task_complete",
                "on_task_stop",
                "on_escalation",
                "codex_pre_tool",
                "codex_post_tool",
                "codex_before_model_turn",
                "codex_after_model_turn",
                "codex_session_start",
                "codex_pre_compact",
                "codex_post_compact"
              ]
            }
          },
          "argv": {
            "minItems": 1,
            "maxItems": 100,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8000
            }
          },
          "phases": {
            "default": [],
            "maxItems": 4,
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "worker",
                "supervisor",
                "repair",
                "validator"
              ]
            }
          },
          "timeoutSeconds": {
            "default": 30,
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          },
          "intervalSeconds": {
            "default": 30,
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "maxInvocations": {
            "default": 1000,
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          },
          "failurePolicy": {
            "default": "fail",
            "type": "string",
            "enum": [
              "fail",
              "continue"
            ]
          },
          "matcher": {
            "default": ".*",
            "type": "string",
            "maxLength": 200
          }
        },
        "required": [
          "id",
          "events",
          "argv",
          "phases",
          "timeoutSeconds",
          "intervalSeconds",
          "maxInvocations",
          "failurePolicy",
          "matcher"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "name",
    "objective",
    "cwd",
    "worker",
    "argv",
    "resumeArgv",
    "model",
    "reasoningEffort",
    "validator",
    "validationArgv",
    "validationTimeoutSeconds",
    "requiredArtifacts",
    "activityTimeoutSeconds",
    "plan",
    "artifact",
    "progressFile",
    "timeoutSeconds",
    "taskTimeoutSeconds",
    "heartbeatTimeoutSeconds",
    "progressTimeoutSeconds",
    "recovery",
    "maxRetries",
    "backoffSeconds",
    "supervisorModel",
    "supervisorEffort",
    "supervisorTimeoutSeconds",
    "maxSupervisorCalls",
    "allowRepair",
    "repairTimeoutSeconds",
    "networkAccess",
    "goalMonitoring",
    "hooks"
  ],
  "additionalProperties": false
}
